[Unit]
Description=EyeVoice Next.js website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eyevoice
Group=eyevoice
WorkingDirectory=/opt/eyevoice/site
Environment=NODE_ENV=production
EnvironmentFile=/etc/eyevoice/site.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eyevoice/site/.next

[Install]
WantedBy=multi-user.target
